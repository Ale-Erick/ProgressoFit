# ProgressoFit - .gitignore (Django)

# Ambiente virtual (nunca commitar o venv)
venv/
.venv/
env/
ENV/

# Banco de dados local (cada máquina cria o seu com "python manage.py migrate")
db.sqlite3
db.sqlite3-journal
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Django
*.log
local_settings.py
media/
staticfiles/
static_root/

# Variáveis de ambiente e arquivos sensíveis (Aula 01: não versionar senhas/chaves)
.env
.env.*
*.pem
*.key

# Testes e cobertura
.coverage
htmlcov/
.pytest_cache/
.tox/

# Editores e IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini